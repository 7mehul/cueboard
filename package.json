{
  "name": "cueboard",
  "version": "0.1.0",
  "description": "Meeting prep boards: say what a meeting is for, get a visual plan of how it should run and what you need in it.",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/7mehul/cueboard.git"
  },
  "homepage": "https://github.com/7mehul/cueboard#readme",
  "bugs": {
    "url": "https://github.com/7mehul/cueboard/issues"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/serve.ts",
    "demo": "node scripts/serve.ts 5190 --demo --fake-model",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "scale": "node scripts/scale.ts",
    "gallery": "node scripts/gallery.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.136.0",
    "ical.js": "^2.2.1",
    "zod": "^4.6.7"
  }
}
