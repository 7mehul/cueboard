# Every setting Cueboard reads. None are needed to try it: `npm run demo` runs with none of them.
# Copy this file to .env and fill in what you need; `npm start` and `docker compose up` read it.
# .env is ignored by git. Never commit real values. A setting left empty counts as not set.

# --- Claude (reading what you paste, drafting boards, the assistant, research) ---
# On your own computer you can sign in once with the ant CLI (`ant auth login`) and leave this
# empty. On a server, put your API key here.
ANTHROPIC_API_KEY=
# Which model drafts boards (default claude-opus-5-5)
CUE_MODEL=

# --- A password, for running it on a server ---
# Needed whenever other machines can reach Cueboard (the Docker setup always can). Every browser
# signs in once with it, for 30 days; changing it signs every browser out.
# At least 12 characters. One way to make one: openssl rand -base64 18
CUE_PASSWORD=

# --- Google Calendar sign-in (optional; a calendar's private link works without any of this) ---
# Your own OAuth client from Google Cloud: see "Calendar: boards without asking" in the README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Granola (import past meeting notes; needs a Granola Business plan) ---
GRANOLA_API_KEY=

# --- Where it runs (the Docker setup sets these itself) ---
# Where it listens: 127.0.0.1, this machine only, unless you change it. 0.0.0.0 opens it to every
# network this machine is on, and needs CUE_PASSWORD.
# CUE_HOST=127.0.0.1
# PORT=5180
# Where it keeps the key that seals sign-ins and calendar access (default: data/ in this folder)
# CUE_DATA_DIR=
