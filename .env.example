# Every setting Cueboard reads. All are optional for trying it: `node scripts/serve.ts --demo --fake-model`
# runs with none of them. Copy to .env, fill in what you need, and start with
#   node --env-file=.env scripts/serve.ts
# .env is ignored by git. Never commit real values.

# --- Claude (reading what you paste, drafting boards, the assistant) ---
# Either sign in once with the ant CLI (`ant auth login`) and leave this empty, or put your API key here.
ANTHROPIC_API_KEY=
# Which model drafts boards (default claude-opus-5-5)
CUE_MODEL=

# --- Google Calendar (boards draft themselves for meetings with outside guests) ---
# Your own OAuth client from Google Cloud: see "Calendar: boards without asking" in the README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Granola (import past meeting notes; needs a Granola Business plan) ---
GRANOLA_API_KEY=

# --- Hosted mode only (node scripts/serve.ts --hosted) ---
# Invites as name:code pairs, comma separated. Make codes with: node scripts/invite.ts alice bob
CUE_INVITES=
# Invite names that can see /admin
CUE_ADMINS=
# A long random string that signs session cookies: openssl rand -hex 32
CUE_SECRET=
# Where the usage log is kept
CUE_DATA_DIR=
# Model calls per tester per day, and for everyone per day
CUE_DAILY_CALLS=150
CUE_DAILY_TOTAL=1000
PORT=
