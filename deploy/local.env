# For trying the hosted version on this machine only:
#   node --env-file=deploy/local.env scripts/serve.ts 5183 --hosted --fake-model
# Then open http://localhost:5183/join#local-tester-invite (or #local-admin-invite, which can see /admin).
# These values are public in this repo: the server refuses them on a real host.
CUE_INVITES=tester:local-tester-invite,admin:local-admin-invite
CUE_ADMINS=admin
CUE_SECRET=local-only-secret-not-for-hosting-0123456789
CUE_DAILY_CALLS=6
