{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cueboard",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/serve.ts",
        "5180"
      ],
      "port": 5180
    },
    {
      "name": "cueboard-fake",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/serve.ts",
        "5181",
        "--fake-model",
        "--fake-granola",
        "--fake-calendar"
      ],
      "port": 5181
    },
    {
      "name": "cueboard-hosted",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file=deploy/local.env",
        "scripts/serve.ts",
        "5183",
        "--hosted",
        "--fake-model"
      ],
      "port": 5183
    }
  ]
}
